{
  "name": "dsh-dnshe-domain",
  "version": "1.0.3",
  "description": "DNSHE 免费域名插件（DSH）：把免费二级域名的注册/续期/解析管理接进 DeepSeek Harness —— A/AAAA/CNAME/TXT/MX/SRV/CAA 增删改查、配额、到期巡检、WHOIS。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "dnshe",
    "dns",
    "domain",
    "free-domain",
    "subdomain",
    "ddns",
    "acme",
    "certbot"
  ],
  "author": "shizukugzs",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
